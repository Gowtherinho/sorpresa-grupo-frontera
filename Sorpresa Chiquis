<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Una sorpresa para ti ❤️</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
      color: #ffffff;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .card {
      background: rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 24px;
      padding: 32px 24px;
      max-width: 420px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }

    h1 {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 12px;
      color: #f43f5e;
    }

    p.subtitle {
      font-size: 1rem;
      color: #cbd5e1;
      margin-bottom: 24px;
      line-height: 1.5;
    }

    .btn-surprise {
      background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
      color: #fff;
      border: none;
      padding: 16px 32px;
      font-size: 1.05rem;
      font-weight: 600;
      border-radius: 50px;
      cursor: pointer;
      box-shadow: 0 10px 25px rgba(225, 29, 72, 0.4);
      transition: all 0.3s ease;
    }

    .btn-surprise:active {
      transform: scale(0.96);
    }

    .reveal-section {
      display: none;
      margin-top: 24px;
      animation: fadeIn 0.8s ease forwards;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .ticket-img {
      width: 100%;
      border-radius: 16px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 12px 24px rgba(0,0,0,0.5);
      margin-bottom: 20px;
    }

    .message {
      font-size: 1.1rem;
      color: #f8fafc;
      font-weight: 500;
      line-height: 1.6;
    }

    .footer-note {
      margin-top: 16px;
      font-size: 0.9rem;
      color: #fb7185;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div class="card">
    <div id="cover-section">
      <h1>Tengo una sorpresa para ti ✨</h1>
      <p class="subtitle">Preparé este detalle especial porque no podía aguantar la emoción de contártelo...</p>
      <button class="btn-surprise" onclick="mostrarSorpresa()">Descubrir sorpresa 🎁</button>
    </div>

    <div id="reveal-section" class="reveal-section">
      <!-- Cambia 'imagen_grupo_frontera.jpg' por el nombre exacto de tu imagen -->
      <img src="imagen_grupo_frontera.jpg" alt="Nos vamos al concierto de Grupo Frontera" class="ticket-img">
      <p class="message">¡Nos vamos a ver a <strong>Grupo Frontera</strong> juntos! 🤠🎶</p>
      <p class="footer-note">¡Prepara la voz que vamos a cantar con todo!</p>
    </div>
  </div>

  <script>
    function mostrarSorpresa() {
      document.getElementById('cover-section').style.display = 'none';
      document.getElementById('reveal-section').style.display = 'block';
    }
  </script>

</body>
</html>
